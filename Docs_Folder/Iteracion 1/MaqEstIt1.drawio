<mxfile host="app.diagrams.net">
  <diagram id="Flujo_Estados_Mejorado" name="Diagrama_Flujo">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Nodos de Inicio y Fin -->
        <mxCell id="node_start" parent="1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;" vertex="1">
          <mxGeometry x="395" y="30" width="30" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="node_end" parent="1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=3;" vertex="1">
          <mxGeometry x="640" y="115" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="node_end_inner" parent="node_end" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;" vertex="1">
          <mxGeometry x="6" y="6" width="18" height="18" as="geometry" />
        </mxCell>

        <!-- Estado Principal (Loop) -->
        <mxCell id="state_main" parent="1" value="Ejecución del Sistema&lt;br&gt;(Menú Principal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1">
          <mxGeometry x="310" y="100" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Estados / Acciones -->
        <mxCell id="act_1" parent="1" value="Calcular Fondos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#333333;" vertex="1">
          <mxGeometry x="60" y="240" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act_2" parent="1" value="Gestionar Hipotecas&lt;br&gt;(CRUD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#333333;" vertex="1">
          <mxGeometry x="230" y="240" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act_3" parent="1" value="Gestionar Inversiones&lt;br&gt;(CRUD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#333333;" vertex="1">
          <mxGeometry x="400" y="240" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act_4" parent="1" value="Generar e Imprimir&lt;br&gt;Reportes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#333333;" vertex="1">
          <mxGeometry x="570" y="240" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- Conexiones -->
        <mxCell id="edge_start" edge="1" parent="1" source="node_start" target="state_main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_end" edge="1" parent="1" source="state_main" target="node_end" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label_salir" parent="edge_end" value="Salir" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontColor=#666666;" vertex="1" connectable="0">
          <mxGeometry x="-0.2" y="-2" relative="1" as="geometry">
            <mxPoint y="-12" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Ida hacia las acciones -->
        <mxCell id="edge_to_act1" edge="1" parent="1" source="state_main" target="act_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=1.5;exitX=0.25;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_to_act2" edge="1" parent="1" source="state_main" target="act_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_to_act3" edge="1" parent="1" source="state_main" target="act_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=1.5;exitX=0.75;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_to_act4" edge="1" parent="1" source="state_main" target="act_4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=1.5;exitX=0.875;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Retorno al bucle principal (Loop) -->
        <mxCell id="edge_ret1" edge="1" parent="1" source="act_1" target="state_main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="270" />
              <mxPoint x="40" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_ret2" edge="1" parent="1" source="act_2" target="state_main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.75;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="210" y="270" />
              <mxPoint x="210" y="145" />
            </Array>
          </mxGeometry>
